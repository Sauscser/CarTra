{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Idempotently aggregate annual learner performance facts into National CBE rollups",
  "Parameters": {
    "deploymentBucketName": { "Type": "String" },
    "env": { "Type": "String" },
    "s3Key": { "Type": "String" },
    "apiCartraGraphQLAPIIdOutput": { "Type": "String" }
  },
  "Conditions": {
    "ShouldNotCreateEnvResources": {
      "Fn::Equals": [{ "Ref": "env" }, "NONE"]
    }
  },
  "Resources": {
    "LambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Metadata": {
        "aws:asset:path": "./src",
        "aws:asset:property": "Code"
      },
      "Properties": {
        "Code": {
          "S3Bucket": { "Ref": "deploymentBucketName" },
          "S3Key": { "Ref": "s3Key" }
        },
        "Handler": "index.handler",
        "FunctionName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            "nationalcberollup",
            { "Fn::Join": ["", ["nationalcberollup-", { "Ref": "env" }]] }
          ]
        },
        "Environment": {
          "Variables": {
            "ENV": { "Ref": "env" },
            "REGION": { "Ref": "AWS::Region" },
            "API_ID": { "Ref": "apiCartraGraphQLAPIIdOutput" },
            "PERFORMANCE_TABLE_NAME": {
              "Fn::Join": ["", ["LearnerSubjectPerformance-", { "Ref": "apiCartraGraphQLAPIIdOutput" }, "-", { "Ref": "env" }]]
            },
            "ROLLUP_TABLE_NAME": {
              "Fn::Join": ["", ["NationalCbeRollup-", { "Ref": "apiCartraGraphQLAPIIdOutput" }, "-", { "Ref": "env" }]]
            }
          }
        },
        "Role": { "Fn::GetAtt": ["LambdaExecutionRole", "Arn"] },
        "Runtime": "nodejs22.x",
        "Timeout": 60,
        "MemorySize": 256
      }
    },
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            "nationalcberollupRole",
            { "Fn::Join": ["", ["nationalcberollupRole-", { "Ref": "env" }]] }
          ]
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": { "Service": ["lambda.amazonaws.com"] },
            "Action": ["sts:AssumeRole"]
          }]
        }
      }
    },
    "LambdaExecutionPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": { "Fn::Join": ["", ["nationalcberollup-policy-", { "Ref": "env" }]] },
        "Roles": [{ "Ref": "LambdaExecutionRole" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
              "Resource": { "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${LambdaFunction}:*" }
            },
            {
              "Effect": "Allow",
              "Action": ["dynamodb:DescribeStream", "dynamodb:GetRecords", "dynamodb:GetShardIterator", "dynamodb:ListStreams"],
              "Resource": {
                "Fn::Join": ["", ["arn:", { "Ref": "AWS::Partition" }, ":dynamodb:", { "Ref": "AWS::Region" }, ":", { "Ref": "AWS::AccountId" }, ":table/LearnerSubjectPerformance-", { "Ref": "apiCartraGraphQLAPIIdOutput" }, "-", { "Ref": "env" }, "/stream/*"]]
              }
            },
            {
              "Effect": "Allow",
              "Action": ["dynamodb:GetItem", "dynamodb:TransactWriteItems"],
              "Resource": [
                {
                  "Fn::Join": ["", ["arn:", { "Ref": "AWS::Partition" }, ":dynamodb:", { "Ref": "AWS::Region" }, ":", { "Ref": "AWS::AccountId" }, ":table/NationalCbeRollup-", { "Ref": "apiCartraGraphQLAPIIdOutput" }, "-", { "Ref": "env"}]]
                },
                {
                  "Fn::Join": ["", ["arn:", { "Ref": "AWS::Partition" }, ":dynamodb:", { "Ref": "AWS::Region" }, ":", { "Ref": "AWS::AccountId" }, ":table/LearnerSubjectPerformance-", { "Ref": "apiCartraGraphQLAPIIdOutput" }, "-", { "Ref": "env"}]]
                }
              ]
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Name": { "Value": { "Ref": "LambdaFunction" } },
    "Arn": { "Value": { "Fn::GetAtt": ["LambdaFunction", "Arn"] } },
    "Region": { "Value": { "Ref": "AWS::Region" } },
    "LambdaExecutionRole": { "Value": { "Ref": "LambdaExecutionRole" } },
    "LambdaExecutionRoleArn": { "Value": { "Fn::GetAtt": ["LambdaExecutionRole", "Arn"] } }
  }
}
